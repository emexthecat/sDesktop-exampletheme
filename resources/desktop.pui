Import "config.pui"

//the whole screen is one context, the desktop registered it, the
//taskbar lives here at the bottom edge
SetContext(Desktop)
{
    Container(
        ID("desktop.background")
        Style(
            height(fill),
            width(fill),
            bg(Background)
        )
    ){
        //Image(Background)
    }

    Container(
        ID("desktop.taskbar")
        Style(
            anchor(bottom),
            height(TaskbarHeight),
            width(fill),
            bg(TaskbarBackground)
        )
    ){
        Button(
            ID("taskbar.button.terminal"),
            Style(
                height(TaskbarButtonHeight),
                bg(rgb(25, 25, 25))
            )
        ){
            OnHover(
                tooltip(
                    "open Terminal",
                    Style(
                        width(108px),// 8 * 13 + 2 + 2
                                     // 8 = font letter width
                                     // 13 = 13 letters
                                     // 2 = 2px padding left
                                     // 2 = 2px padding right
                        height(18px),// 16 + 1 + 1
                                     // 16 = font letter height
                                     // 1 = 1px padding left
                                     // 1 = 1px padding right
                        border(argb(255, 90, 90, 90), 1px),
                        bg(argb(255, 75, 75, 75))
                    )
                ),
                bg(argb(255, 45, 45, 45))
            )
            Image("/usr/share/applications/terminal.png"),
            Execute(DefaultTerminal)
        }
    }
}
