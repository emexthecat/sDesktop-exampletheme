Import "config.pui"

SetContext(Window)
{
    //window data comes from the wm, the config only describes its ui
    SetArg(Window.drag.titleth, 20px) //titleth = dragable title from top, height is 20px

    // gets calculated into height and width
    SetArg(Window.content.area, Array(
        WindowTitleHeight, // top
        3px, // right
        3px, // bottom
        3px  // left
    ))

    Container(
        Style(
            width(fill),
            height(fill),
            padding(3px), //each side
            bg(WindowTitleColor)
        )
    ){
        Container(
            Style(
                width(fill),
                height(fill),
                bg(WindowContentColor)
            )
        )
    }
    
    Container(
        ID("window.decorations"),
        Style(
            layout(row),
            width(fill),
            height(WindowTitleHeight), // font is 12px, so it leaves us 6px space for 3px up and 3px down
            bg(WindowTitleColor)
        )
    ) {
        // the Context is Window (SetContext) which stores informations
        // about the Window like the title or height, width or z-order,
        // we need the title for window decoration tho so we use Bind()
        Label(GetArg(Window.title))
    }
}
